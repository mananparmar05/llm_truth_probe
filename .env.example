# ============================================================
# LLM Hallucination Detection — Environment Variables
# Copy this file to .env and configure your credentials/settings.
# ============================================================

# ── HuggingFace Hub ──────────────────────────────────────────
# Required for downloading gated LLM weights (e.g. meta-llama/Llama-3.1-8B)
HUGGINGFACE_TOKEN=hf_your_token_here
HF_HUB_ENABLE_HF_TRANSFER=1

# ── Model & Device Settings ──────────────────────────────────
# GPU device index or 'auto' / 'cpu' / 'cuda:0'
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda

# ── Storage & Paths ──────────────────────────────────────────
DATA_DIR=data/
HIDDEN_STATES_DIR=data/hidden_states/
RESULTS_DIR=results/
MODELS_DIR=results/models/

# ── Experiment Tracking ──────────────────────────────────────
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=llm-hallucination-detection
MLFLOW_TRACKING_URI=http://localhost:5000

# ── FastAPI Serving (Phase 7) ────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MODEL_NAME=Qwen/Qwen2.5-7B
PROBE_PATH=results/models/probe_layer14_logistic_regression.pkl
BEST_LAYER=14
